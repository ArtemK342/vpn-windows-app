<UserControl x:Class="FsocietyNet.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:FsocietyNet.Views">
    <UserControl.Resources>
        <!-- Round power button -->
        <Style x:Key="PowerBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="bg" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                            <Ellipse x:Name="ov" Fill="Transparent"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ov" Property="Fill" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ov" Property="Fill" Value="{DynamicResource PressBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ServerRowTemplate">
            <Border x:Name="row" Background="Transparent" CornerRadius="11" Padding="14,11" Margin="8,1" Cursor="Hand"
                    Opacity="{Binding RowOpacity}" BorderThickness="1" BorderBrush="Transparent"
                    MouseLeftButtonUp="Row_Click" MouseRightButtonUp="Row_RightClick" ToolTip="{Binding Hint}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <v:Flag Country="{Binding Country}" Width="24" Height="16" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="{Binding Protocol}" Style="{StaticResource ChipText}"/>
                            </Border>
                            <Border Style="{StaticResource Chip}" Margin="6,0,0,0" Background="{DynamicResource DangerSoftBrush}"
                                    Visibility="{Binding LogsVisibility}">
                                <TextBlock Text="● LOGS ON" Style="{StaticResource ChipText}" Foreground="{DynamicResource DangerBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding Message}" Style="{StaticResource T.Caps}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{Binding MessageBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                               FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="3" Style="{StaticResource Btn.Icon}" Width="30" Height="30" Click="Star_Click"
                            ToolTip="{Binding StarHint}">
                        <v:Icon Data="{StaticResource I.Star}" Size="16" Filled="{Binding IsFavorite}" Brush="{Binding StarBrush}"/>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=row}" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentLineBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,44,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Maintenance banner (Settings → Access in the admin panel) -->
        <Border x:Name="MaintBanner" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,14" CornerRadius="12" Padding="14,10"
                Background="{DynamicResource WarnSoftBrush}">
            <StackPanel Orientation="Horizontal">
                <v:Icon Data="{StaticResource I.Warn}" Size="17" Brush="{DynamicResource WarnBrush}" VerticalAlignment="Top"/>
                <TextBlock x:Name="MaintText" Foreground="{DynamicResource WarnBrush}" FontSize="12.5" Margin="10,0,0,0"
                           TextWrapping="Wrap" MaxWidth="760"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" MinWidth="330"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="13*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Connection card ═══ -->
            <Border Style="{StaticResource Card}">
                <Grid Margin="24,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{v:T home.label}" Style="{StaticResource T.Label}"/>
                        <TextBlock x:Name="StateTitle" Style="{StaticResource T.H1}" FontSize="27" Margin="0,8,0,0"/>
                        <TextBlock x:Name="StateSub" Style="{StaticResource T.Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <!-- Settings → Bypass → «always»: the zapret service runs next to the VPN -->
                        <TextBlock x:Name="BypassStatus" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="0,14,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Power button with ring -->
                    <Grid Grid.Row="1" Width="236" Height="236" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                        <Ellipse x:Name="Glow" Width="236" Height="236" Fill="{DynamicResource AccentSoftBrush}" Opacity="0"/>
                        <Ellipse x:Name="Ring" Width="212" Height="212" Stroke="{DynamicResource LineBrush}" StrokeThickness="2"/>
                        <Path x:Name="Spinner" Width="212" Height="212" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                              Data="M106,1 A105,105 0 0 1 211,106" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinRotate"/>
                            </Path.RenderTransform>
                        </Path>
                        <Button x:Name="PowerBtn" Style="{StaticResource PowerBtn}" Width="168" Height="168"
                                Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource Line2Brush}"
                                Click="Power_Click">
                            <StackPanel>
                                <v:Icon x:Name="PowerIcon" Data="{StaticResource I.Power}" Size="54" Stroke="2"
                                        HorizontalAlignment="Center" Brush="{DynamicResource MutedBrush}"/>
                                <TextBlock x:Name="PowerText" HorizontalAlignment="Center" Margin="0,10,0,0" FontFamily="{StaticResource MonoFont}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <!-- Live stats -->
                        <Grid x:Name="StatsRow" Visibility="Collapsed" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{v:T home.time}" Style="{StaticResource T.Caps}"/>
                                <TextBlock x:Name="TimeText" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{v:T home.down}" Style="{StaticResource T.Caps}"/>
                                <TextBlock x:Name="DownText" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock x:Name="DownTotal" Style="{StaticResource T.Caps}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{v:T home.up}" Style="{StaticResource T.Caps}"/>
                                <TextBlock x:Name="UpText" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock x:Name="UpTotal" Style="{StaticResource T.Caps}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12.5" TextWrapping="Wrap"
                                   Visibility="Collapsed" Margin="0,0,0,10"/>
                        <TextBlock x:Name="NoteText" Style="{StaticResource T.Note}" Visibility="Collapsed" Margin="0,0,0,10"/>
                        <Button x:Name="UnblockBtn" Style="{StaticResource Btn.Danger}" Content="{v:T home.unblock}"
                                Visibility="Collapsed" Click="Unblock_Click" Margin="0,0,0,10"/>

                        <!-- Free plan: traffic left -->
                        <Border x:Name="UsageBox" Visibility="Collapsed" Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="12,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="UsageText" FontSize="12.5"/>
                                    <TextBlock x:Name="UsageSpeed" Style="{StaticResource T.Caps}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Height="5" Margin="0,8,0,0" ClipToBounds="True">
                                    <Border CornerRadius="3" Background="{DynamicResource LineBrush}"/>
                                    <Border x:Name="UsageBar" CornerRadius="3" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Servers ═══ -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="22,18,14,10">
                        <StackPanel>
                            <TextBlock Text="{v:T home.servers_label}" Style="{StaticResource T.Label}"/>
                            <TextBlock Text="{v:T home.servers_title}" Style="{StaticResource T.H2}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Border Background="{DynamicResource BgBrush}" CornerRadius="10" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TabAll" Style="{StaticResource Segment}" GroupName="srv" IsChecked="True"
                                                 Content="{v:T home.tab_all}" Checked="Tab_Checked"/>
                                    <RadioButton x:Name="TabFav" Style="{StaticResource Segment}" GroupName="srv"
                                                 Content="{v:T home.tab_fav}" Checked="Tab_Checked"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="RefreshBtn" Style="{StaticResource Btn.Icon}" Margin="6,0,0,0" Click="Refresh_Click"
                                    ToolTip="{v:T home.refresh}">
                                <v:Icon Data="{StaticResource I.Refresh}" Size="17"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="List" Grid.Row="1" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainItem}"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             ItemTemplate="{StaticResource ServerRowTemplate}" Margin="0,0,0,6">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel x:Name="hdr" Margin="22,10,22,8">
                                            <Border Height="1" Background="{DynamicResource LineBrush}" Margin="-14,0,-14,16"/>
                                            <TextBlock Text="{v:T home.reserve_label}" Style="{StaticResource T.Label}"/>
                                            <TextBlock Text="{v:T home.reserve_title}" Style="{StaticResource T.H2}" FontSize="17" Margin="0,6,0,0"/>
                                            <TextBlock Text="{v:T home.reserve_sub}" Style="{StaticResource T.Caps}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="main">
                                                <Setter TargetName="hdr" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                    <StackPanel x:Name="ListEmpty" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="ListEmptyText" Style="{StaticResource T.Muted}" TextAlignment="Center"/>
                        <Button x:Name="RetryBtn" Style="{StaticResource Btn.Secondary}" Content="{v:T common.retry}" Margin="0,12,0,0"
                                HorizontalAlignment="Center" Click="Refresh_Click" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="ListHint" Grid.Row="2" Text="{v:T home.hint_right_click}" Style="{StaticResource T.Note}" Margin="22,0,22,14"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
