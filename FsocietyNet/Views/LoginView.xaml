<UserControl x:Class="FsocietyNet.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:FsocietyNet.Views">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="380"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <!-- Brand side -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="48,56,48,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <v:Brand Size="34"/>
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Run Text="[" Foreground="{DynamicResource MutedBrush}"/><Run Text="f" Foreground="{DynamicResource AccentTextBrush}"/><Run Text="]society"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="{v:T login.hero_label}" Style="{StaticResource T.Label}"/>
                    <TextBlock Text="{v:T login.hero}" Style="{StaticResource T.H1}" FontSize="36" LineHeight="42" Margin="0,12,0,0"/>
                    <StackPanel Margin="0,28,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <v:Icon Data="{StaticResource I.ShieldCheck}" Size="18" Brush="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="{v:T login.point1}" Style="{StaticResource T.Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <v:Icon Data="{StaticResource I.Bolt}" Size="18" Brush="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="{v:T login.point2}" Style="{StaticResource T.Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <v:Icon Data="{StaticResource I.Key}" Size="18" Brush="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="{v:T login.point3}" Style="{StaticResource T.Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Link}" Click="Telegram_Click">
                        <StackPanel Orientation="Horizontal">
                            <v:Icon Data="{StaticResource I.Telegram}" Size="15"/>
                            <TextBlock Text="{v:T login.telegram}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="  ·  " Foreground="{DynamicResource FaintBrush}"/>
                    <Button x:Name="LangBtn" Style="{StaticResource Btn.Link}" Click="Lang_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form side -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="560">
                <StackPanel Width="360" VerticalAlignment="Center" Margin="0,60,0,40">

                    <!-- Email login -->
                    <StackPanel x:Name="PanelEmail">
                        <TextBlock Text="{v:T login.sub_email}" Style="{StaticResource T.Label}"/>
                        <TextBlock Text="{v:T login.title}" Style="{StaticResource T.H1}" Margin="0,8,0,24"/>
                        <TextBlock Text="{v:T login.email}" Style="{StaticResource T.Caps}" Margin="0,0,0,6"/>
                        <TextBox x:Name="Email" Style="{StaticResource Input}" Tag="you@example.com"/>
                        <Grid Margin="0,14,0,6">
                            <TextBlock Text="{v:T login.password}" Style="{StaticResource T.Caps}"/>
                            <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" FontSize="11.5"
                                    Content="{v:T login.forgot}" Click="Forgot_Click"/>
                        </Grid>
                        <PasswordBox x:Name="Password" Style="{StaticResource PasswordInput}" KeyDown="Password_KeyDown"/>
                        <Button x:Name="LoginBtn" Style="{StaticResource Btn.Primary}" Height="44" Margin="0,22,0,0"
                                Content="{v:T login.btn}" Click="Login_Click"/>
                        <Button Style="{StaticResource Btn.Secondary}" Height="42" Margin="0,10,0,0"
                                Content="{v:T login.btn_anon}" Click="ToCode_Click"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <TextBlock Text="{v:T login.no_account}" Style="{StaticResource T.Muted}"/>
                            <Button Style="{StaticResource Btn.Link}" Margin="8,0,0,0" Content="{v:T login.btn_register}" Click="ToRegister_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Anonymous code login -->
                    <StackPanel x:Name="PanelCode" Visibility="Collapsed">
                        <TextBlock Text="{v:T login.sub_anon}" Style="{StaticResource T.Label}"/>
                        <TextBlock Text="{v:T login.title}" Style="{StaticResource T.H1}" Margin="0,8,0,24"/>
                        <TextBlock Text="{v:T login.code}" Style="{StaticResource T.Caps}" Margin="0,0,0,6"/>
                        <TextBox x:Name="Code" Style="{StaticResource Input}" Tag="0000-0000-0000-0000" FontFamily="{StaticResource MonoFont}"
                                 FontSize="16" MaxLength="19" TextChanged="Code_TextChanged" KeyDown="Code_KeyDown"/>
                        <TextBlock Text="{v:T login.code_hint}" Style="{StaticResource T.Note}" Margin="0,8,0,0"/>
                        <Button x:Name="CodeBtn" Style="{StaticResource Btn.Primary}" Height="44" Margin="0,22,0,0"
                                Content="{v:T login.btn}" Click="CodeLogin_Click"/>
                        <Button Style="{StaticResource Btn.Secondary}" Height="42" Margin="0,10,0,0"
                                Content="{v:T login.anon_create}" Click="ToAnon_Click"/>
                        <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Center" Margin="0,22,0,0"
                                Content="{v:T login.btn_email}" Click="ToEmail_Click"/>
                    </StackPanel>

                    <!-- Registration -->
                    <StackPanel x:Name="PanelRegister" Visibility="Collapsed">
                        <TextBlock Text="{v:T register.sub}" Style="{StaticResource T.Label}"/>
                        <TextBlock Text="{v:T register.title}" Style="{StaticResource T.H1}" Margin="0,8,0,24"/>
                        <TextBlock Text="{v:T login.email}" Style="{StaticResource T.Caps}" Margin="0,0,0,6"/>
                        <TextBox x:Name="RegEmail" Style="{StaticResource Input}" Tag="you@example.com"/>
                        <TextBlock Text="{v:T login.password}" Style="{StaticResource T.Caps}" Margin="0,14,0,6"/>
                        <PasswordBox x:Name="RegPassword" Style="{StaticResource PasswordInput}"/>
                        <TextBlock Text="{v:T register.repeat}" Style="{StaticResource T.Caps}" Margin="0,14,0,6"/>
                        <PasswordBox x:Name="RegPassword2" Style="{StaticResource PasswordInput}"/>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="Accept" Style="{StaticResource Switch}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Margin="12,2,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource MutedBrush}">
                                <Run Text="{v:T privacy.accept}"/>
                                <Hyperlink Click="Privacy_Click" Foreground="{DynamicResource AccentTextBrush}"><Run Text="{v:T privacy.policy}"/></Hyperlink>
                                <Run Text="{v:T privacy.and}"/>
                                <Hyperlink Click="Terms_Click" Foreground="{DynamicResource AccentTextBrush}"><Run Text="{v:T privacy.terms}"/></Hyperlink>
                            </TextBlock>
                        </Grid>
                        <Button x:Name="RegBtn" Style="{StaticResource Btn.Primary}" Height="44" Margin="0,22,0,0"
                                Content="{v:T register.btn}" Click="Register_Click"/>
                        <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Center" Margin="0,22,0,0"
                                Content="{v:T register.back}" Click="ToEmail_Click"/>
                    </StackPanel>

                    <!-- Anonymous account: create -->
                    <StackPanel x:Name="PanelAnon" Visibility="Collapsed">
                        <TextBlock Text="{v:T register.sub}" Style="{StaticResource T.Label}"/>
                        <TextBlock Text="{v:T anon.title}" Style="{StaticResource T.H1}" Margin="0,8,0,16"/>
                        <TextBlock Text="{v:T anon.desc}" Style="{StaticResource T.Muted}"/>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="AcceptAnon" Style="{StaticResource Switch}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Margin="12,2,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource MutedBrush}">
                                <Run Text="{v:T privacy.accept}"/>
                                <Hyperlink Click="Privacy_Click" Foreground="{DynamicResource AccentTextBrush}"><Run Text="{v:T privacy.policy}"/></Hyperlink>
                                <Run Text="{v:T privacy.and}"/>
                                <Hyperlink Click="Terms_Click" Foreground="{DynamicResource AccentTextBrush}"><Run Text="{v:T privacy.terms}"/></Hyperlink>
                            </TextBlock>
                        </Grid>
                        <Button x:Name="AnonBtn" Style="{StaticResource Btn.Primary}" Height="44" Margin="0,22,0,0"
                                Content="{v:T anon.btn}" Click="CreateAnon_Click"/>
                        <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Center" Margin="0,22,0,0"
                                Content="{v:T common.back}" Click="ToCode_Click"/>
                    </StackPanel>

                    <!-- Anonymous account: the code -->
                    <StackPanel x:Name="PanelAnonCode" Visibility="Collapsed">
                        <TextBlock Text="{v:T anon.code_sub}" Style="{StaticResource T.Label}"/>
                        <TextBlock Text="{v:T anon.code_title}" Style="{StaticResource T.H1}" Margin="0,8,0,20"/>
                        <Border Style="{StaticResource Card}" Padding="18,16" Cursor="Hand" MouseLeftButtonUp="CopyCode_Click"
                                BorderBrush="{DynamicResource AccentLineBrush}" Background="{DynamicResource AccentSoftBrush}">
                            <StackPanel>
                                <TextBlock Text="{v:T anon.code_label}" Style="{StaticResource T.Caps}"/>
                                <TextBlock x:Name="AnonCode" FontFamily="{StaticResource MonoFont}" FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,8,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <v:Icon Data="{StaticResource I.Copy}" Size="14" Brush="{DynamicResource AccentTextBrush}"/>
                                    <TextBlock Text="{v:T anon.tap_copy}" Style="{StaticResource T.Caps}" Margin="6,0,0,0"
                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <v:Icon Data="{StaticResource I.Warn}" Size="16" Brush="{DynamicResource WarnBrush}"/>
                            <TextBlock Text="{v:T anon.warning}" Foreground="{DynamicResource WarnBrush}" FontSize="12.5"
                                       Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="330"/>
                        </StackPanel>
                        <Button Style="{StaticResource Btn.Secondary}" Height="40" Margin="0,18,0,0"
                                Content="{v:T anon.save_file}" Click="SaveCode_Click"/>
                        <Button Style="{StaticResource Btn.Primary}" Height="44" Margin="0,10,0,0"
                                Content="{v:T anon.login}" Click="AnonEnter_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="Error" Foreground="{DynamicResource DangerBrush}" FontSize="12.5" TextWrapping="Wrap"
                               Margin="0,16,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="Info" Foreground="{DynamicResource AccentTextBrush}" FontSize="12.5" TextWrapping="Wrap"
                               Margin="0,16,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
