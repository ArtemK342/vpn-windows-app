<UserControl x:Class="FsocietyNet.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:FsocietyNet.Views">
    <UserControl.Resources>
        <Style x:Key="PresetChip" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="8" Padding="10,5" BorderThickness="1"
                                BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource Surface2Brush}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Line2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentLineBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,44,32,28">
            <TextBlock Text="{v:T rules.section}" Style="{StaticResource T.Label}"/>
            <TextBlock Text="{v:T rules.title}" Style="{StaticResource T.H1}" Margin="0,8,0,6"/>
            <TextBlock Text="{v:T rules.support}" Style="{StaticResource T.Note}"/>

            <!-- Reconnect to apply -->
            <Border x:Name="ApplyBar" Visibility="Collapsed" Margin="0,16,0,0" CornerRadius="12" Padding="14,10"
                    Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentLineBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="{v:T rules.apply_text}" VerticalAlignment="Center" FontSize="12.5"/>
                    <Button Style="{StaticResource Btn.Primary}" Height="32" Padding="14,0" HorizontalAlignment="Right"
                            Content="{v:T rules.apply_btn}" Click="Apply_Click"/>
                </Grid>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══ Sites ═══ -->
                <Border Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <v:Icon Data="{StaticResource I.Globe}" Size="19" Brush="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{v:T rules.sites}" Style="{StaticResource T.H2}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="SitesOn" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="SitesOn_Click"/>
                        </Grid>
                        <TextBlock x:Name="SitesSummary" Style="{StaticResource T.Muted}" Margin="0,6,0,14"/>

                        <RadioButton x:Name="SitesExclude" Style="{StaticResource OptionCard}" GroupName="sm" Checked="SitesMode_Checked">
                            <StackPanel>
                                <TextBlock Text="{v:T rules.mode_exclude}" FontWeight="SemiBold"/>
                                <TextBlock Text="{v:T rules.mode_exclude_sites}" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="SitesInclude" Style="{StaticResource OptionCard}" GroupName="sm" Checked="SitesMode_Checked">
                            <StackPanel>
                                <TextBlock Text="{v:T rules.mode_include}" FontWeight="SemiBold"/>
                                <TextBlock Text="{v:T rules.mode_include_sites}" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SiteInput" Style="{StaticResource Input}" Tag="{v:T rules.sites_placeholder}" KeyDown="SiteInput_KeyDown"/>
                            <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Width="42" Height="42" Padding="0" Margin="8,0,0,0"
                                    HorizontalContentAlignment="Center" Click="AddSite_Click">
                                <v:Icon Data="{StaticResource I.Plus}" Size="18"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="SiteError" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>
                        <TextBlock Text="{v:T rules.sites_hint}" Style="{StaticResource T.Note}" Margin="0,8,0,0"/>

                        <TextBlock Text="{v:T rules.presets}" Style="{StaticResource T.Label}" Margin="0,16,0,8"/>
                        <WrapPanel x:Name="Presets"/>

                        <Grid Margin="0,12,0,6">
                            <TextBlock x:Name="SitesCount" Style="{StaticResource T.Label}"/>
                            <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" FontSize="12"
                                    Content="{v:T rules.clear}" Click="ClearSites_Click"/>
                        </Grid>
                        <Border Background="{DynamicResource BgBrush}" CornerRadius="10" MaxHeight="230" MinHeight="60">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="SitesList" Margin="4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,2">
                                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,36,0"/>
                                                    <Button Style="{StaticResource Btn.Icon}" Width="28" Height="28" HorizontalAlignment="Right"
                                                            Tag="{Binding Entry}" Click="RemoveSite_Click">
                                                        <v:Icon Data="{StaticResource I.Close}" Size="13"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="SitesEmpty" Text="{v:T rules.list_empty}" Style="{StaticResource T.Note}" Margin="14,12" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{v:T rules.awg_sites_note}" Style="{StaticResource T.Note}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ═══ Apps ═══ -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <v:Icon Data="{StaticResource I.Terminal}" Size="19" Brush="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{v:T rules.apps}" Style="{StaticResource T.H2}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="AppsOn" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="AppsOn_Click"/>
                        </Grid>
                        <TextBlock x:Name="AppsSummary" Style="{StaticResource T.Muted}" Margin="0,6,0,14"/>

                        <RadioButton x:Name="AppsExclude" Style="{StaticResource OptionCard}" GroupName="am" Checked="AppsMode_Checked">
                            <StackPanel>
                                <TextBlock Text="{v:T rules.mode_exclude}" FontWeight="SemiBold"/>
                                <TextBlock Text="{v:T rules.mode_exclude_apps}" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="AppsInclude" Style="{StaticResource OptionCard}" GroupName="am" Checked="AppsMode_Checked">
                            <StackPanel>
                                <TextBlock Text="{v:T rules.mode_include}" FontWeight="SemiBold"/>
                                <TextBlock Text="{v:T rules.mode_include_apps}" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <Border x:Name="BlockedPreset" Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="12,10" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{v:T rules.preset_blocked}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BlockedDesc" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BlockedBtn" Grid.Column="1" Style="{StaticResource Btn.Secondary}" Height="32" Padding="12,0"
                                        Margin="10,0,0,0" VerticalAlignment="Center" Content="{v:T rules.add}" Click="BlockedPreset_Click"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AppSearch" Style="{StaticResource Input}" Tag="{v:T rules.search}" TextChanged="AppSearch_TextChanged"/>
                            <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Height="42" Padding="12,0" Margin="8,0,0,0"
                                    Content="{v:T rules.pick_exe}" Click="PickExe_Click"/>
                        </Grid>

                        <TextBlock x:Name="AppsCount" Style="{StaticResource T.Label}" Margin="0,12,0,6"/>
                        <Border Background="{DynamicResource BgBrush}" CornerRadius="10" Height="300">
                            <Grid>
                                <ListBox x:Name="AppsList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource PlainItem}"
                                         VirtualizingPanel.IsVirtualizing="True" Margin="4">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding IconImage}" Width="20" Height="20" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Exe}" Style="{StaticResource T.Caps}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Selected, Mode=OneWay}"
                                                          Tag="{Binding}" Click="AppToggle_Click" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="AppsLoading" Text="{v:T common.loading}" Style="{StaticResource T.Note}" Margin="14,12"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{v:T rules.apps_note}" Style="{StaticResource T.Note}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{v:T rules.footer}" Style="{StaticResource T.Note}" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
