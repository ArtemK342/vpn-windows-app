<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme (brand: site and Android). Swapped at runtime by Services/Theme.cs, so every style uses
         these keys through DynamicResource. -->
    <Color x:Key="AccentColor">#C8F135</Color>
    <Color x:Key="DangerColor">#FF5A5A</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <SolidColorBrush x:Key="BgBrush"          Color="#0B0B0C"/>
    <SolidColorBrush x:Key="SidebarBrush"     Color="#0F0F11"/>
    <SolidColorBrush x:Key="SurfaceBrush"     Color="#141416"/>
    <SolidColorBrush x:Key="Surface2Brush"    Color="#1A1A1D"/>
    <SolidColorBrush x:Key="HoverBrush"       Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="PressBrush"       Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="LineBrush"        Color="#25252A"/>
    <SolidColorBrush x:Key="Line2Brush"       Color="#33333A"/>
    <SolidColorBrush x:Key="TextBrush"        Color="#EDEDEF"/>
    <SolidColorBrush x:Key="MutedBrush"       Color="#8F8F98"/>
    <SolidColorBrush x:Key="FaintBrush"       Color="#58585F"/>
    <SolidColorBrush x:Key="AccentBrush"      Color="#C8F135"/>
    <SolidColorBrush x:Key="AccentTextBrush"  Color="#C8F135"/>
    <SolidColorBrush x:Key="OnAccentBrush"    Color="#0B0B0C"/>
    <SolidColorBrush x:Key="AccentSoftBrush"  Color="#1CC8F135"/>
    <SolidColorBrush x:Key="AccentLineBrush"  Color="#55C8F135"/>
    <SolidColorBrush x:Key="DangerBrush"      Color="#FF5A5A"/>
    <SolidColorBrush x:Key="DangerSoftBrush"  Color="#1FFF5A5A"/>
    <SolidColorBrush x:Key="WarnBrush"        Color="#FFB547"/>
    <SolidColorBrush x:Key="WarnSoftBrush"    Color="#1FFFB547"/>
    <SolidColorBrush x:Key="InfoBrush"        Color="#7AB8FF"/>
    <SolidColorBrush x:Key="OverlayBrush"     Color="#B3050506"/>
    <SolidColorBrush x:Key="FlagEdgeBrush"    Color="#2EFFFFFF"/>
</ResourceDictionary>
