<UserControl x:Class="FsocietyNet.Controls.LoginControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDarkBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="340" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="0,60,0,40">

            <!-- Логотип -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="[f]" Foreground="{StaticResource AccentBrush}"
                           FontFamily="Consolas" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="society" Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="Consolas" FontSize="32" FontWeight="Bold"/>
            </StackPanel>
            <TextBlock Text="// ВХОД В АККАУНТ" Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Email -->
            <TextBlock Text="EMAIL" Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Consolas" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="EmailBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,16"/>

            <!-- Пароль -->
            <TextBlock Text="ПАРОЛЬ" Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Consolas" FontSize="11" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource DarkPasswordBox}" Margin="0,0,0,8"/>

            <TextBlock Text="Забыл пароль?" Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Consolas" FontSize="11" TextDecorations="Underline"
                       Cursor="Hand" Margin="0,0,0,12"/>

            <!-- Ошибка -->
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorRedBrush}"
                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,12"/>

            <!-- Кнопка войти -->
            <Button x:Name="LoginBtn" Content="ВОЙТИ →" Style="{StaticResource PrimaryButton}"
                    Click="LoginBtn_Click" Margin="0,0,0,12"/>

            <TextBlock Text="Поддержка в Telegram" Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center"
                       TextDecorations="Underline" Cursor="Hand" Margin="0,0,0,32"
                       MouseLeftButtonUp="TelegramLink_Click"/>

            <Separator Background="{StaticResource BorderBrush2}" Margin="0,0,0,24"/>

            <TextBlock Text="Нет аккаунта?" Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <Button Content="ЗАРЕГИСТРИРОВАТЬСЯ →" Style="{StaticResource SecondaryButton}"
                    Click="RegisterBtn_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
