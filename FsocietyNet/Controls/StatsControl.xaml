<UserControl x:Class="FsocietyNet.Controls.StatsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDarkBrush}"
             Unloaded="UserControl_Unloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Заголовок -->
            <StackPanel Margin="24,48,24,8">
                <TextBlock Text="// СТАТИСТИКА" Foreground="{StaticResource AccentBrush}"
                           FontFamily="Consolas" FontSize="11"/>
                <TextBlock Text="Трафик и сессии." Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Статус сессии -->
            <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Margin="0,16,0,0">
                <Grid Margin="24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ТЕКУЩАЯ СЕССИЯ" Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Consolas" FontSize="10"/>
                        <TextBlock x:Name="SessionStatusText" Text="Нет подключения"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Consolas" FontSize="14" FontWeight="Bold" Margin="0,6,0,0"/>
                        <TextBlock x:Name="SessionTimeText" Text=""
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                    <Button x:Name="RefreshStatsBtn" Grid.Column="1"
                            Content="↺ Обновить" Style="{StaticResource SecondaryButton}"
                            Height="36" Padding="16,0" FontSize="11"
                            Click="RefreshStatsBtn_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Карточки трафика -->
            <Grid Margin="24,16,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Получено -->
                <Border Grid.Column="0" Background="{StaticResource Bg2Brush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                    <StackPanel Margin="20,16">
                        <TextBlock Text="↓  ПОЛУЧЕНО" Foreground="{StaticResource AccentBrush}"
                                   FontFamily="Consolas" FontSize="10"/>
                        <TextBlock x:Name="RxText" Text="—"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="RxUnitText" Text=""
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Consolas" FontSize="10"/>
                    </StackPanel>
                </Border>

                <!-- Отправлено -->
                <Border Grid.Column="2" Background="{StaticResource Bg2Brush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                    <StackPanel Margin="20,16">
                        <TextBlock Text="↑  ОТПРАВЛЕНО" Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Consolas" FontSize="10"/>
                        <TextBlock x:Name="TxText" Text="—"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="TxUnitText" Text=""
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Consolas" FontSize="10"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Скорость -->
            <Grid Margin="24,8,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Bg2Brush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                    <StackPanel Margin="20,12">
                        <TextBlock Text="↓  СКОРОСТЬ" Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Consolas" FontSize="10"/>
                        <TextBlock x:Name="RxSpeedText" Text="—"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource Bg2Brush}"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
                    <StackPanel Margin="20,12">
                        <TextBlock Text="↑  СКОРОСТЬ" Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Consolas" FontSize="10"/>
                        <TextBlock x:Name="TxSpeedText" Text="—"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Интерфейс -->
            <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Margin="0,24,0,0">
                <StackPanel Margin="24,16">
                    <TextBlock Text="СЕТЕВОЙ ИНТЕРФЕЙС" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas" FontSize="10"/>
                    <TextBlock x:Name="IfaceText" Text="—"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                               Margin="0,6,0,0"/>
                    <TextBlock x:Name="IfaceIpText" Text=""
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Подсказка -->
            <TextBlock x:Name="HintText"
                       Text="Подключитесь к VPN, чтобы видеть статистику трафика."
                       Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Consolas" FontSize="11"
                       Margin="24,16,24,48" TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
