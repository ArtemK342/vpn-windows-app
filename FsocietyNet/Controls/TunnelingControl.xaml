<UserControl x:Class="FsocietyNet.Controls.TunnelingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDarkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Заголовок -->
            <RowDefinition Height="Auto"/>  <!-- Тип: Приложения / Сайты -->
            <RowDefinition Height="*"/>     <!-- Контент -->
        </Grid.RowDefinitions>

        <!-- ── Заголовок ── -->
        <StackPanel Grid.Row="0" Margin="24,36,24,0">
            <TextBlock Text="// ТУННЕЛИРОВАНИЕ" Foreground="{StaticResource AccentBrush}"
                       FontFamily="Consolas" FontSize="11"/>
            <TextBlock Text="Раздельный туннель." Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
            <TextBlock Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap">
                <Run Text="Выберите, какой трафик идёт через VPN — по сайтам/IP или по приложениям."/>
            </TextBlock>
        </StackPanel>

        <!-- ── Тип-переключатель ── -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,1"
                Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" Margin="24,0" Height="44">
                <TextBlock x:Name="AppsTabText" Text="Приложения"
                           Foreground="{StaticResource AccentBrush}"
                           FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                           VerticalAlignment="Center" Cursor="Hand"
                           MouseLeftButtonUp="AppsTab_Click"/>
                <TextBlock Text=" / " Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="SitesTabText" Text="Сайты и IP"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Consolas" FontSize="12"
                           VerticalAlignment="Center" Cursor="Hand"
                           MouseLeftButtonUp="SitesTab_Click"/>
            </StackPanel>
        </Border>

        <!-- ── Контент ── -->
        <Grid Grid.Row="2">

            <!-- ══ Приложения ══ -->
            <Grid x:Name="AppsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Режим -->
                <StackPanel Grid.Row="0" Margin="24,16,24,0">
                    <TextBlock Text="РЕЖИМ" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas" FontSize="10" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" >
                        <Button x:Name="AppModeAllBtn"    Content="Весь трафик"
                                Tag="All"    Click="AppModeBtn_Click"
                                Style="{StaticResource PrimaryButton}"
                                Height="34" Padding="16,0" FontSize="11"/>
                        <Button x:Name="AppModeIncBtn"    Content="Только выбранные"
                                Tag="Include" Click="AppModeBtn_Click"
                                Style="{StaticResource SecondaryButton}"
                                Height="34" Padding="16,0" FontSize="11" Margin="8,0,0,0"/>
                        <Button x:Name="AppModeExcBtn"    Content="Везде, кроме"
                                Tag="Exclude" Click="AppModeBtn_Click"
                                Style="{StaticResource SecondaryButton}"
                                Height="34" Padding="16,0" FontSize="11" Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="AppModeDesc" Margin="0,12,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Список приложений -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel x:Name="AppList" Margin="24,0,24,0"/>
                </ScrollViewer>

                <!-- Добавить -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Margin="24,12">
                        <Button Content="+ Из запущенных" Style="{StaticResource SecondaryButton}"
                                Height="38" Padding="16,0" FontSize="11"
                                Click="AddFromProcessesBtn_Click"/>
                        <Button Content="+ Выбрать .exe" Style="{StaticResource SecondaryButton}"
                                Height="38" Padding="16,0" FontSize="11"
                                Margin="8,0,0,0" Click="AddExeBtn_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ Сайты и IP ══ -->
            <Grid x:Name="SitesPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Режим -->
                <StackPanel Grid.Row="0" Margin="24,16,24,0">
                    <TextBlock Text="РЕЖИМ" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas" FontSize="10" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SiteModeAllBtn"    Content="Весь трафик"
                                Tag="All"    Click="SiteModeBtn_Click"
                                Style="{StaticResource PrimaryButton}"
                                Height="34" Padding="16,0" FontSize="11"/>
                        <Button x:Name="SiteModeIncBtn"    Content="Только выбранные"
                                Tag="Include" Click="SiteModeBtn_Click"
                                Style="{StaticResource SecondaryButton}"
                                Height="34" Padding="16,0" FontSize="11" Margin="8,0,0,0"/>
                        <Button x:Name="SiteModeExcBtn"    Content="Везде, кроме"
                                Tag="Exclude" Click="SiteModeBtn_Click"
                                Style="{StaticResource SecondaryButton}"
                                Height="34" Padding="16,0" FontSize="11" Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="SiteModeDesc" Margin="0,12,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Список IP/CIDR -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel x:Name="SiteList" Margin="24,0,24,0"/>
                </ScrollViewer>

                <!-- Добавить домен / IP / CIDR -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
                    <StackPanel Margin="24,12">
                        <!-- Пресеты -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="ПРЕСЕТЫ:" Foreground="{StaticResource TextMutedBrush}"
                                       FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <Button x:Name="RuPresetBtn"
                                    Content="+ RU Essential"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="30" Padding="12,0" FontSize="10"
                                    Click="RuPresetBtn_Click"/>
                        </StackPanel>
                        <!-- Ввод -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SiteInputBox" Grid.Column="0"
                                     Style="{StaticResource DarkTextBox}"
                                     Height="38" VerticalContentAlignment="Center"
                                     Text="" MaxLength="128"
                                     KeyDown="SiteInputBox_KeyDown"/>
                            <Button Grid.Column="2" Content="+ Добавить"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="38" Padding="16,0" FontSize="11"
                                    Click="AddSiteBtn_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
