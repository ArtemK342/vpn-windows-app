<UserControl x:Class="FsocietyNet.Controls.AppShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDarkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя навигация -->
        <Border Grid.Row="0" Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="[f]" Foreground="{StaticResource AccentBrush}"
                               FontFamily="Consolas" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="society" Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Consolas" FontSize="17" FontWeight="Bold"/>
                </StackPanel>

                <!-- Вкладки -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="HomeTabBtn"    Content="ГЛАВНАЯ"
                            Style="{StaticResource TabButtonActive}" Click="HomeTab_Click"/>
                    <Button x:Name="TunnelTabBtn"  Content="ТУННЕЛИРОВАНИЕ"
                            Style="{StaticResource TabButton}"       Click="TunnelTab_Click"/>
                    <Button x:Name="SupportTabBtn" Content="ПОДДЕРЖКА"
                            Style="{StaticResource TabButton}"       Click="SupportTab_Click"/>
                    <Button x:Name="SettingsTabBtn" Content="НАСТРОЙКИ"
                            Style="{StaticResource TabButton}"       Click="SettingsTab_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Контент -->
        <ContentControl x:Name="TabContent" Grid.Row="1"/>
    </Grid>
</UserControl>
