<UserControl x:Class="FsocietyNet.Controls.AppShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDarkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>   <!-- Row 0: tab bar / title bar -->
            <RowDefinition Height="Auto"/> <!-- Row 1: update banner -->
            <RowDefinition Height="*"/>    <!-- Row 2: content -->
        </Grid.RowDefinitions>

        <!-- Title bar / Nav bar -->
        <Border Grid.Row="0" Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- Logo -->
                    <ColumnDefinition Width="*"/>     <!-- Tabs -->
                    <ColumnDefinition Width="Auto"/>  <!-- Window controls -->
                </Grid.ColumnDefinitions>

                <!-- Логотип (draggable area behind it) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="20,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="[" Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="f" Foreground="{StaticResource AccentBrush}"
                               FontFamily="Consolas" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="]society" Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Consolas" FontSize="16" FontWeight="Bold"/>
                </StackPanel>

                <!-- Вкладки -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,0,4,0">
                    <Button x:Name="HomeTabBtn"      Content="Главная"
                            Style="{StaticResource TabButtonActive}" Click="HomeTab_Click"/>
                    <Button x:Name="TunnelTabBtn"    Content="Туннель"
                            Style="{StaticResource TabButton}"       Click="TunnelTab_Click"/>
                    <Button x:Name="StatsTabBtn"     Content="Статистика"
                            Style="{StaticResource TabButton}"       Click="StatsTab_Click"/>
                    <Button x:Name="SupportTabBtn"   Content="Поддержка"
                            Style="{StaticResource TabButton}"       Click="SupportTab_Click"/>
                    <Button x:Name="SettingsTabBtn"  Content="Настройки"
                            Style="{StaticResource TabButton}"       Click="SettingsTab_Click"/>
                </StackPanel>

                <!-- Кнопки управления окном -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="—" Style="{StaticResource WinCtrlBtn}"
                            Click="MinimizeBtn_Click"/>
                    <Button Content="✕" Style="{StaticResource WinCloseBtn}"
                            Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Баннер обновления -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed"
                Background="#0A1500" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,8">
                <TextBlock x:Name="UpdateText" Foreground="{StaticResource AccentBrush}"
                           FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                <Button x:Name="UpdateBtn" HorizontalAlignment="Right"
                        Content="Скачать →" Style="{StaticResource PrimaryButton}"
                        Height="30" Padding="14,0" FontSize="11" Click="UpdateBtn_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!-- Контент -->
        <ContentControl x:Name="TabContent" Grid.Row="2"/>
    </Grid>
</UserControl>
