<UserControl x:Class="FsocietyNet.Controls.HomeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDarkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>  <!-- Статус-баннер -->
            <RowDefinition Height="*"/>   <!-- Основной контент -->
        </Grid.RowDefinitions>

        <!-- ═══ Статус-баннер (full width, как у AdGuard) ═══ -->
        <Border Grid.Row="0" Background="{StaticResource Bg2Brush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid Margin="32,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectedText"
                               Text="○  Отключён"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas" FontSize="13"/>
                    <TextBlock x:Name="StatusText" Text=""
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas" FontSize="10"
                               Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <!-- Баннер бесплатного трафика (справа) -->
                <StackPanel x:Name="UsageBanner" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="UsageText"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas" FontSize="10"
                               HorizontalAlignment="Right"/>
                    <Grid Margin="0,4,0,0" Height="3" Width="160">
                        <Rectangle Fill="{StaticResource BorderBrush2}" RadiusX="1" RadiusY="1"/>
                        <Rectangle x:Name="UsageBar" Fill="{StaticResource AccentBrush}"
                                   RadiusX="1" RadiusY="1" HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Двухколоночный контент ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: логотип + кнопка -->
            <Grid Grid.Column="0" Background="{StaticResource Bg2Brush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="[f]"
                           Foreground="{StaticResource AccentBrush}"
                           FontFamily="Consolas" FontSize="72" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button x:Name="ConnectBtn" Grid.Row="1"
                        Content="Подключиться" Style="{StaticResource PrimaryButton}"
                        Height="60" Click="ConnectBtn_Click"
                        FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="16"/>
            </Grid>

            <!-- Правая панель: список серверов -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Вкладки + кнопка обновления -->
                <Border Grid.Row="0" Height="48"
                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="AllTabText" Grid.Column="0" Text="ВСЕ"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Cursor="Hand" MouseLeftButtonUp="AllTab_Click"/>

                        <TextBlock x:Name="FavTabText" Grid.Column="2" Text="ИЗБРАННЫЕ"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center"
                                   Cursor="Hand" MouseLeftButtonUp="FavTab_Click"/>

                        <Button x:Name="RefreshBtn" Grid.Column="4"
                                Content="↺" FontSize="17"
                                Foreground="{StaticResource TextMutedBrush}"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Click="RefreshBtn_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"     Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor"         Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Список серверов -->
                <Grid Grid.Row="1">
                    <TextBlock x:Name="LoadingText" Text="Загрузка серверов..."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <ListBox x:Name="ServerList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="Collapsed"
                             SelectionChanged="ServerList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding"                   Value="0"/>
                                <Setter Property="Margin"                    Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background"               Value="Transparent"/>
                                <Setter Property="Cursor"                   Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{StaticResource BorderBrush2}"
                                                    BorderThickness="0,0,0,1">
                                                <ContentPresenter Margin="20,14"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{StaticResource SurfaceBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{StaticResource SurfaceBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Flag}"
                                               FontSize="18" Margin="0,0,14,0"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="13" FontWeight="Bold"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2" Text="{Binding PingText}"
                                               Foreground="{Binding PingColor}"
                                               FontFamily="Consolas" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>

                                    <!-- Иконка избранного -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding FavoriteIcon}"
                                               Foreground="{Binding FavoriteColor}"
                                               FontSize="14" VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Cursor="Hand"
                                               PreviewMouseLeftButtonDown="Star_Down"
                                               PreviewMouseLeftButtonUp="Star_Up"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
