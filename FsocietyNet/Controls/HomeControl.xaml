<UserControl x:Class="FsocietyNet.Controls.HomeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDarkBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: статус + кнопка -->
        <Grid Grid.Column="0" Background="{StaticResource Bg2Brush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Центральный блок: [f] + статус -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="[f]" Foreground="{StaticResource AccentBrush}"
                           FontFamily="Consolas" FontSize="72" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ConnectedText" Text="○ Отключён"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Consolas" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,20,0,0"/>
                <TextBlock x:Name="StatusText" Text=""
                           Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Consolas" FontSize="10"
                           HorizontalAlignment="Center" Margin="0,6,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Кнопка подключения -->
            <Button x:Name="ConnectBtn" Grid.Row="1"
                    Content="○ ПОДКЛЮЧИТЬСЯ" Style="{StaticResource PrimaryButton}"
                    Height="56" Margin="0" Click="ConnectBtn_Click" IsEnabled="False"/>
        </Grid>

        <!-- Правая панель: список серверов -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Вкладки ВСЕ / ИЗБРАННЫЕ -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                <Grid Margin="24,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AllTabText" Grid.Column="0" Text="ВСЕ"
                               Foreground="{StaticResource AccentBrush}"
                               FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                               Cursor="Hand" MouseLeftButtonUp="AllTab_Click"/>
                    <TextBlock x:Name="FavTabText" Grid.Column="2" Text="ИЗБРАННЫЕ"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas" FontSize="11"
                               Cursor="Hand" MouseLeftButtonUp="FavTab_Click"/>
                </Grid>
            </Border>

            <!-- Список серверов -->
            <Grid Grid.Row="1">
                <TextBlock x:Name="LoadingText" Text="Загрузка серверов..."
                           Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Consolas" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ListBox x:Name="ServerList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="Collapsed"
                         SelectionChanged="ServerList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"          Value="0"/>
                            <Setter Property="Margin"           Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background"       Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource BorderBrush2}"
                                                BorderThickness="0,0,0,1">
                                            <ContentPresenter Margin="24,16"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource SurfaceBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource SurfaceBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Flag}"
                                           FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding PingText}"
                                           Foreground="{Binding PingColor}"
                                           FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
