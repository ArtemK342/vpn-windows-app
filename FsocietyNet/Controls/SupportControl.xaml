<UserControl x:Class="FsocietyNet.Controls.SupportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDarkBrush}">
    <Grid>
        <!-- ══ Панель: список тикетов ══ -->
        <Grid x:Name="ListPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="24,48,24,16">
                <TextBlock Text="// ПОДДЕРЖКА" Foreground="{StaticResource AccentBrush}"
                           FontFamily="Consolas" FontSize="11"/>
                <TextBlock Text="Тикеты." Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                <TextBlock Text="Максимум 3 открытых тикета. Среднее время ответа — до 24 ч."
                           Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Consolas" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Список -->
            <Grid Grid.Row="1">
                <TextBlock x:Name="ListLoadingText" Text="Загрузка..."
                           Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Consolas" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <TextBlock x:Name="EmptyText" Text="У вас нет тикетов. Создайте первый ↓"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Consolas" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>

                <ScrollViewer x:Name="TicketScroll" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel x:Name="TicketList" Margin="0"/>
                </ScrollViewer>
            </Grid>

            <!-- Кнопка создания -->
            <Button Grid.Row="2" Content="+ НОВЫЙ ТИКЕТ"
                    Style="{StaticResource PrimaryButton}"
                    Height="52" Margin="24,16"
                    Click="NewTicketBtn_Click"/>
        </Grid>

        <!-- ══ Панель: создание тикета ══ -->
        <Grid x:Name="CreatePanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="24,48,24,24">
                <Button Content="← Назад" Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left" Height="36" Padding="16,0" FontSize="11"
                        Click="BackToList_Click"/>
                <TextBlock Text="Новый тикет" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="22" FontWeight="Bold" Margin="0,16,0,0"/>
                <TextBlock Text="Опишите проблему в теме — агент поддержки ответит в чате тикета."
                           Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Consolas" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="24,0">
                <TextBlock Text="ТЕМА ТИКЕТА" Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="Consolas" FontSize="10" Margin="0,0,0,8"/>
                <TextBox x:Name="SubjectBox"
                         Style="{StaticResource DarkTextBox}"
                         MaxLength="120"
                         TextWrapping="Wrap" AcceptsReturn="False"/>
                <TextBlock x:Name="CreateErrorText" Text=""
                           Foreground="{StaticResource ErrorRedBrush}"
                           FontFamily="Consolas" FontSize="11"
                           Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <Button Grid.Row="2" x:Name="SubmitTicketBtn"
                    Content="СОЗДАТЬ ТИКЕТ →"
                    Style="{StaticResource PrimaryButton}"
                    Height="52" Margin="24,16"
                    Click="SubmitTicketBtn_Click"/>
        </Grid>

        <!-- ══ Панель: детали тикета ══ -->
        <Grid x:Name="DetailPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                <Grid Margin="24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="←" Style="{StaticResource SecondaryButton}"
                            Width="40" Height="40" FontSize="16"
                            Click="BackToList_Click"/>
                    <StackPanel Grid.Column="1" Margin="16,0">
                        <TextBlock x:Name="DetailSubjectText" Text="Загрузка..."
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="DetailStatusText" Text=""
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="Consolas" FontSize="10" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="CloseTicketBtn" Grid.Column="2"
                            Content="ЗАКРЫТЬ ТИКЕТ" Style="{StaticResource DangerButton}"
                            Height="36" Padding="12,0" FontSize="11"
                            Click="CloseTicketBtn_Click"/>
                </Grid>
            </Border>

            <!-- Сообщения -->
            <ScrollViewer x:Name="MessagesScroll" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MessagesList" Margin="24,16"/>
            </ScrollViewer>

            <!-- Форма ответа -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
                <Grid Margin="24,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ReplyBox" Grid.Column="0"
                             Style="{StaticResource DarkTextBox}"
                             Height="44" MaxLength="2000"
                             VerticalContentAlignment="Center"/>
                    <Button x:Name="SendReplyBtn" Grid.Column="2"
                            Content="→" Style="{StaticResource PrimaryButton}"
                            Width="48" Height="44"
                            Click="SendReplyBtn_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
