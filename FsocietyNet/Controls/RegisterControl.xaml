<UserControl x:Class="FsocietyNet.Controls.RegisterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDarkBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="340" HorizontalAlignment="Center" Margin="0,60,0,40">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="[f]" Foreground="{StaticResource AccentBrush}"
                           FontFamily="Consolas" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="society" Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="Consolas" FontSize="32" FontWeight="Bold"/>
            </StackPanel>
            <TextBlock Text="// РЕГИСТРАЦИЯ" Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <TextBlock Text="EMAIL" Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Consolas" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="EmailBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,16"/>

            <TextBlock Text="ПАРОЛЬ" Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Consolas" FontSize="11" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource DarkPasswordBox}" Margin="0,0,0,16"/>

            <TextBlock Text="ПОВТОРИТЕ ПАРОЛЬ" Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Consolas" FontSize="11" Margin="0,0,0,4"/>
            <PasswordBox x:Name="Password2Box" Style="{StaticResource DarkPasswordBox}" Margin="0,0,0,12"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorRedBrush}"
                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,8"/>
            <TextBlock x:Name="SuccessText" Foreground="{StaticResource AccentBrush}"
                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,8"/>

            <Button x:Name="RegisterBtn" Content="ЗАРЕГИСТРИРОВАТЬСЯ →"
                    Style="{StaticResource PrimaryButton}" Click="RegisterBtn_Click" Margin="0,0,0,16"/>

            <TextBlock Text="← Уже есть аккаунт? Войти"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontFamily="Consolas" FontSize="11" TextDecorations="Underline"
                       HorizontalAlignment="Center" Cursor="Hand"
                       MouseLeftButtonUp="BackLink_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
