<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FsocietyNet</AssemblyName>
    <RootNamespace>FsocietyNet</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.0.4.0</Version>
    <Product>FsocietyNet</Product>
    <Company>fsociety</Company>
    <Copyright>fsociety-vpn.org</Copyright>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- WFAC010: DPI is set in the manifest on purpose (WPF window); CS4014: fire-and-forget UI loads -->
    <NoWarn>$(NoWarn);WFAC010;CS4014</NoWarn>
  </PropertyGroup>

  <!-- Preview build (dotnet build -p:Preview=true): no admin prompt, used for `FsocietyNet.exe -render <dir>`
       (screens with demo data → PNG) and UI checks without touching the network or the VPN. -->
  <PropertyGroup Condition="'$(Preview)'=='true'">
    <ApplicationManifest>app.preview.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);PREVIEW</DefineConstants>
  </PropertyGroup>

  <!-- Remove conflicting implicit usings that clash between WPF and WinForms -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- Same picture as the Android launcher icon (ic_launcher-playstore.png): app.ico and tray icons are drawn from it -->
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <!-- VPN binaries, extracted at runtime to %ProgramData%\FsocietyNet\bin (Services\Binaries.cs).
       amneziawg.exe + wintun.dll are in git; sing-box.zip and byedpi.zip come from tools\fetch-binaries.ps1
       (official releases, pinned sha256). Without them the build still works — those protocols say so. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\amneziawg.exe" Condition="Exists('Resources\amneziawg.exe')" LogicalName="bin.amneziawg.exe" />
    <EmbeddedResource Include="Resources\wintun.dll" Condition="Exists('Resources\wintun.dll')" LogicalName="bin.wintun.dll" />
    <EmbeddedResource Include="Resources\sing-box.zip" Condition="Exists('Resources\sing-box.zip') And '$(Preview)'!='true'" LogicalName="bin.sing-box.zip" />
    <EmbeddedResource Include="Resources\byedpi.zip" Condition="Exists('Resources\byedpi.zip')" LogicalName="bin.byedpi.zip" />
    <!-- zapret-discord-youtube (Flowseal) official release zip: Settings → Bypass, Services\Zapret.cs -->
    <EmbeddedResource Include="Resources\zapret.zip" Condition="Exists('Resources\zapret.zip')" LogicalName="bin.zapret.zip" />
  </ItemGroup>
</Project>
